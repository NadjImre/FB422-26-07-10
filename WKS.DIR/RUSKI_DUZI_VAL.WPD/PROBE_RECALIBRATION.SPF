PROC PROBE_RECALIBRATION
DEF INT BROJAC
def int errno;broj greske koja se vraca prilikom snimanja
def string[32] fname;naziv fajla za snimanje
def string[128] poruka ; pomocna promenljiva za ispis poruke
Def int me_CalibRepetition=10
G500X0G0T0D0
G0B0A0

me_tool="zond"
me_tool_number = gett("zond")
me_tool_Dnumber = 1
me_diameter = 120
me_position = 824
me_distance = 5
me_feed = 60
me_ProbeUp = 22
me_ProbeDown = 23
me_probe_number = 1
me_status = 15317
me_frame = 2
me_tolerance = 0.002
me_with_Caxis = 0
me_Caxis_Position = 45
me_RepetitionCount = 1
me_MeasureCount = 1
me_ReturnMode = 16 ; bez vracanja nazad, 32-vracanje po X, 48-vracanje po Z, 0 - vracanje X+Z
me_Probe_AutoUP =  64; bez podizanja sonde na kraju, 0 - sa podizanjem 
STOPRE
;merenje za rekalibraciju
;poruka za pocetak 
poruka = SPRINT("Measuring diameter %8.3f on position Z=%8.3f in %d points with %d repetition",me_diameter,me_position,me_measurecount,me_repetitioncount)
Write(errno,fname,poruka)
;Brojac pokusaja
Brojac=0
ponovo:
;merenje
MS140
;rekalibracija
$tc_dp4[me_tool_number,me_tool_dnumber]=$tc_dp4[me_tool_number,me_tool_dnumber]-0.5*me_avg
;provera pokusaja
if (brojac>me_CalibRepetition) gotof kraj
;provera velicine ako je velika ponovo
brojac=brojac+1
if (ABS(me_avg)>0.002) gotob ponovo

KRAJ:
;G500X0G0T0D0
;M23


M17

