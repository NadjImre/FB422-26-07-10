PROC PROBE_THREAD

me_th_type = 0; 4 je kalibracija sve drugo merenje
me_report_file="/_N_MPF_DIR/LOG_ROLIK2_THREAD"
IF (me_th_type==4) gotof kalibracija
me_offset=0.0
kalibracija:

me_tool="zond"
me_tool_number = gett(me_tool)
me_tool_Dnumber = 1
me_th_diameter = 18
me_th_startdia = 22
me_th_position = 9
me_th_pitch = 6
me_th_step = 1
me_feed = 30
me_ProbeUp = 22
me_ProbeDown = 23
me_probe_number = 1
me_status = 1
me_frame = 3
me_tolerance = 0.1
me_with_Caxis = 1
;me_Caxis_Position = Cnom
me_RepetitionCount = 1
me_MeasureCount = 1
me_ReturnMode = 16
me_Probe_AutoUP = 64
me_th_nom_diametEr=17.683
me_offset=-0.015
STOPRE
ms160

IF (me_th_type==4) gotof kraj
me_th_position = -35
me_offset=-0.02
STOPRE
ms160

KRAJ:
T0D0G0X0G500
M23


M17

;NCG#probe_recalibration#cprobe_recalibration.com#NCCODE3#*NCG;*RO*;*HD*
