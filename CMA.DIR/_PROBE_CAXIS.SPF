PROC _PROBE_CAXIS(String[32] Sonda,int DBrojSonde ,real Xnom ,real Znom ,real Ccalib, real DuzMer, real DuzMerC, real BrzMer, real BrzMerC ,int MSonde ,int BrojSonde ,int Status ,int kordsys ,real DOZRAZ ,int TrebaC ,real Cnom)

def int mode

me_c_type = Status b_and 15

if (me_c_type == 0) gotof kraj

me_tool=Sonda
me_tool_number = gett(sonda)
me_tool_Dnumber = DBrojSonde
me_c_diameter = Xnom
me_c_position = Znom
me_c_calibration = Ccalib
me_distance = DuzMer
me_c_span = DuzMerC
me_feed = BrzMer
me_c_feed = BrzMerC
me_ProbeUp = MSonde
me_ProbeDown = MSonde-1
me_probe_number = BrojSonde
me_status = status
me_frame = kordsys
me_tolerance =DozRaz
me_with_Caxis = TrebaC
me_Caxis_Position = Cnom
me_RepetitionCount = ((Status div 128) b_and 15)+1
me_MeasureCount = ((Status div 2048 ) b_and 15)+1
me_ReturnMode = ( Status b_and 48)
me_Probe_AutoUP = (Status b_and 64)

ms130

;merenje  bez korekcije,samo provera rezultata i ispis greske ako ima
if (me_c_type==1)
   If( ( me_tolerance>0) AND ( me_tolerance<ABS(me_c_result))) gotof greska
   gotof kraj
endif

;merenje sa korecijom
;na bazi ,merenja unosi se korekcija u koord sistem
;ako je greska veće od dozvoljene ispisuje alarm
if (mode==2)
   If( ( me_tolerance>0) AND ( me_tolerance<ABS(me_c_result))) gotof greska
   $P_UIFR[ me_frame-1,C,FI]=-me_c_result
   msg("$66023")
   gotof kraj
endif

;merenje aksijalno i rekalibracija na bazi merenja 
;menja se nominalna vrednost na izmerenu vrednost
;ako je greska veće od dozvoljene ispisuje alarm
if (mode==3)
   If( ( me_tolerance>0) AND ( me_tolerance<ABS(me_w_result))) gotof greska
   me_c_position=me_c_position-me_c_result
gotof kraj
endif

kraj:

M17

greska:

SETAL(65002)
M00
M96

m17
