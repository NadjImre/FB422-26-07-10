PROC _PROBE_CAXIS(String[32] Sonda,int DBrojSonde ,real Xnom ,real Znom ,real Ccalib, real DuzMer, real DuzMerC, real BrzMer, real BrzMerC ,int BrojSonde ,int Status ,int kordsys ,real DOZRAZ , real Xsafe, real Zsafe, real UgaoBose, real PrecnikZavrsetka)

me_c_type = Status b_and 15

if (me_c_type == 0) gotof kraj

me_tool=Sonda
me_tool_number = gett(sonda)
me_tool_Dnumber = DBrojSonde
me_diameter = xnom+duzmer
me_c_diameter = Xnom
me_c_position = Znom
me_c_calibration = Ccalib
me_distance = DuzMer
me_c_span = DuzMerC
me_feed = BrzMer
me_c_feed = BrzMerC
me_probe_number = BrojSonde
me_status = status
me_frame = kordsys
me_tolerance =DozRaz
me_ReturnMode = ( Status b_and 48)
me_Probe_AutoUP = (Status b_and 64)
me_Approach = (Status b_and 229376)
me_SwivelPointX = Xsafe
me_SwivelPointZ = Zsafe
me_BAxis_Angle = UgaoBose
me_ReturnDiameter = PrecnikZavrsetka

ms130

;merenje  bez korekcije,samo provera rezultata i ispis greske ako ima
if (me_c_type==1)
   If( ( me_tolerance>0) AND ( me_tolerance<=ABS(me_deviation))) gotof greska
   gotof kraj
endif

;merenje sa korecijom
;na bazi ,merenja unosi se korekcija u koord sistem
;ako je greska veće od dozvoljene ispisuje alarm
if (me_c_type==2)
   If( ( me_tolerance>0) AND ( me_tolerance<=ABS(me_deviation))) gotof greska
   $P_UIFR[ me_frame-1,C,FI]=-me_deviation
   msg("$66023")
   gotof kraj
endif

;rekalibracija: zapamceni ugao C postaje izmereni
;ako je greska veca od dozvoljene, ugao se ne menja
if (me_c_type==3)
   If( ( me_tolerance>0) AND ( me_tolerance<=ABS(me_deviation))) gotof greska
   me_c_calibration=me_c_result
gotof kraj
endif

kraj:

M17

greska:

SETAL(65002)
M00
M96

m17
