PROC AL600
DEF BOOL PREKIDU=FALSE
; odskok pri abrihtovanju: ako je X u WCS < 0 prvo Z pa X, inace samo X
MSG("$66007")
G40
DIAMOF
G90
STOPRE
IF (PREKIDU==FALSE)
   IF ($AA_IW[X] < 0)
      G0 Z=Ds_OdskokZ
      G0 X=Ds_OdskokX M11 M2=5 M3=5 M5
   ELSE
      G0 X=Ds_OdskokX M11 M2=5 M3=5 M5
   ENDIF
   M20
ELSE
   G1 G40 G90 X=PREKIDXA F=RABHOD
   G75Z0 M11 M2=5 M3=5 M5
ENDIF

M96
STOPRE

M17
