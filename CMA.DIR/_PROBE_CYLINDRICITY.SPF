PROC _PROBE_CYLINDRICITY(String[32] Sonda,int DBrojSonde ,real Xnom ,real Znom1, real Znom2, int BrojMer ,real DuzMer, real BrzMer ,int BrojSonde ,int Status ,int kordsys ,real DOZRAZ ,real RunOut ,real DozCil ,real Xsafe,real Zsafe,Real UgaoBose ,Real PrecnikZavrsetka)

def int mode
def int brojac
def int errno
def string[32] fname
def string[128] poruka
def string[32] PorukaGreska
def real cilindricnost
mode = Status b_and 15

if (mode == 0) gotof kraj

me_tool=Sonda
me_tool_number = gett(sonda)
me_tool_Dnumber = DBrojSonde
me_diameter = Xnom
me_distance = DuzMer
me_feed = BrzMer
me_probe_number = BrojSonde
me_status = status
me_frame = kordsys
me_tolerance =DozRaz
me_runout_tolerance = RunOut
me_cyl_tolerance = DozCil
me_with_Caxis = 1
me_Caxis_Position = 0
me_RepetitionCount = ((Status div 128) b_and 15)+1
me_MeasureCount = ((Status div 2048 ) b_and 15)+1
me_ReturnMode = 16 ;( Status b_and 48)
me_Probe_AutoUP = 64; (Status b_and 64)
me_Approach = (Status b_and 229376)
me_SwivelPointX = Xsafe
me_SwivelPointZ = Zsafe
me_BAxis_Angle = UgaoBose
me_ReturnDiameter = PrecnikZavrsetka
fname=me_report_file

if (mode==4) gotof rucno

me_status=(status div 16)*16+1

poruka = sprint("*** Cylindricity measuring on diameter %12.4f between positions %12.4f and %12.4f***",XNOM,ZNOM1,ZNOM2)
Write(errno,fname,poruka)
For brojac=0 to brojmer-1

    if (brojmer<=1)
       me_position=znom1
    else
       me_position=znom1+(brojac*(znom2-znom1)/(brojmer-1))
    endif
    if (mode==3)
       me_offset=0
    else
       me_offset=me_cyl_offset[brojac]
    endif
    if (brojac==(brojmer-1))
       me_ReturnMode = ( Status b_and 48)
       me_Probe_AutoUP = (Status b_and 64)
    endif
    poruka = sprint("***Measuring diameter %12.4f at position %12.4f ***",me_diameter,me_position)
    Write(errno,fname,poruka)
    ms140
    me_cyl_max[brojac]=me_max
    me_cyl_min[brojac]=me_min
    me_cyl_avg[brojac]=me_avg
    me_cyl_span[brojac]=me_span
    me_Approach = 0
Endfor
me_offset=0
;ukupno od izmerenih preseka
if (brojmer>=1)
   me_max=me_cyl_max[0]
   me_min=me_cyl_min[0]
   me_avg=0
   for brojac=0 to brojmer-1
      if (me_cyl_max[brojac]>me_max)
         me_max=me_cyl_max[brojac]
      endif
      if (me_cyl_min[brojac]<me_min)
         me_min=me_cyl_min[brojac]
      endif
      me_avg=me_avg+me_cyl_avg[brojac]
   endfor
   me_avg=me_avg/brojmer
   me_span=me_max-me_min
   cilindricnost=me_span/2
   me_deviation=me_nominal-me_avg
   if ((abs(me_deviation)>=me_tolerance) and (me_tolerance>0))
      if (me_deviation<0)
         PorukaGreska=sprint("%12.3f",me_deviation+me_tolerance)
      else
         PorukaGreska=sprint("%12.3f",me_deviation-me_tolerance)
      endif
   else
      PorukaGreska=""
   endif
   poruka = SPRINT("%12s %12s %12s %12s %12s %12s %12s","Measure","Section", "Actual","Nominal","Tolerance","Deviation","Error")
   Write(errno,fname,poruka)
   poruka = sprint("%26s%12.3f %12.3f %12.3f %12.3f %12s", "Mean diameter", me_avg, me_nominal, me_tolerance, me_deviation, PorukaGreska)
   Write(errno,fname,poruka)
   if ((cilindricnost>=me_cyl_tolerance) and (me_cyl_tolerance>0))
      PorukaGreska=sprint("%12.3f",cilindricnost-me_cyl_tolerance)
   else
      PorukaGreska=""
   endif
   poruka = sprint("%26s%12.3f %12s %12.3f %12s %12s", "Cylindricity", cilindricnost, "", me_cyl_tolerance, "", PorukaGreska)
   Write(errno,fname,poruka)
   if (mode==3)
      for brojac=0 to brojmer-1
         me_cyl_offset[brojac]=me_nominal-me_cyl_avg[brojac]
      endfor
      gotof kraj
   endif
   for brojac=0 to brojmer-1
      if ((me_tolerance>0) and (abs(me_nominal-me_cyl_avg[brojac])>=me_tolerance))
         gotof greska
      endif
      if ((me_runout_tolerance>0) and (me_cyl_span[brojac]>=me_runout_tolerance))
         gotof greska
      endif
   endfor
   if ((me_tolerance>0) and (abs(me_deviation)>=me_tolerance))
      gotof greska
   endif
   if ((me_cyl_tolerance>0) and (cilindricnost>=me_cyl_tolerance))
      gotof greska
   endif
endif

kraj:

M17

greska:

SETAL(65002)
M00
M96

m17

rucno:

me_offset=0
ms140

m17

