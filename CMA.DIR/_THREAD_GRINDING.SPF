PROC  _THREAD_GRINDING(STRING[32] alat ,INT dbroj, Real UgaoBose, Int Kordsis,Real NacinBrus, Real _ThD2, Real _ThPi, int _ThHa, int _ThSt,REAL POZZ1 ,REAL POZZ2 ,REAL VAR15 ,REAL VAR16,INT HLADJENJEVAR , Real PodHodVar, Int RabHodVar, STRING[100] KONTURA, STRING[100] KOMENT)

Gr_Frame=kordsis
Gr_Tool=ALAT
Gr_DNumber=dbroj
Gr_BAxis_angle=UgaoBose
Th_D2 = _ThD2
Th_Pitch = _ThPi
Th_Hand = _ThHa
Th_Starts = _ThSt mod 100
Gr_Start = (_ThSt div 100) mod 100
if (Gr_Start==0)
   Gr_All_Starts=1
else
   Gr_All_Starts=0
endif

;Gr_Position1=pozz1
;Gr_Position2=pozz2
Gr_DiamCorrection=var15
Gr_PosCorrection=var16
Gr_CAngleCorrection=15

Gr_Coolant=hladjenjevar

Gr_Comment=koment

;Gr_Diameter1=Precnik
Gr_Podhod=PodHodVar
Gr_RabHod=RabHodVar
;TH_conture=KONTURA

T0D0G53G0X0
G0G53B=Gr_BAxis_angle
STOPRE

if (NacinBrus==3)
SH831
Endif

if (NacinBrus==1)
SH850
Endif

if (NacinBrus==4)
SH832
Endif

if (NacinBrus==2)
SH811
Endif

M17


