
Def Real Xa,Za ; 
Def Real Xb,Zb
Def Real Xc,Zc
Def Real Xo,Zo
Def Real Xd,Zd
Def Real Xe,Ze
Def Real Xf,Zf
Def Real Xg,Zg
Def Real Xp,Zp
Def Real Xi,Zi

;pocetna tacka na kraju kamena
Xa = 0
Za = ds_tool_width+ds_podhodZ
;pocetak konusa ako ga ima - duzina je duzina kamena ako je programiran nula
Xb = 0
Zb = ds_taper_length2
;centar radijusa zaobljena po Z
Zo = ds_radius2
;kraj konusa pocetak zaobljenja 
;ako je radijus nula Zc i Xc su nula isto
;ako je ugao konusa nula Xc je nula
;ako se radi čelo kamena
if (ds_Face_Length2>0)
   Zc = Zo-ds_radius2*sin(ds_taper_angle2)
else ; ako se ne radi
   Zc = -ds_PodhodZ
endif
Xc = Xb - (Zb-Zc)*tan(ds_taper_angle2)
;X od centra zobljenja vrha po X osi 
Xo = Xc - ds_radius2*cos(ds_taper_angle2)
;kraj radijusa - pocetak fazete
;ako fazeta nula
if (ds_Margin2==0)
   Xd = Xo-ds_radius2*sin(ds_face_angle2)
   Zd = Zo-ds_radius2*cos(ds_face_angle2)
else ; i ako nije
   Xd = Xo
   Zd = Zo-ds_radius2
endif
;kraj fazete ako ima - inace sito kao Zd,Ze
Ze = Zd
Xe = Xd-ds_margin2
;kraj donjeg radijusa i njegov centar po X - tacke P i G
Xg=-ds_face_Length2
Xp=Xg+ds_podhodZ/2
;pocetak donjeg radijusa
Xf=Xp+0.5*ds_PodhodZ*sin(ds_face_angle2)
Zf=Ze+(Xe-Xf)*tan(ds_face_angle2)
;kraj donjeg radijusa i njegov centar po Z
Zg=Zf-0.5*ds_PodhodZ*cos(ds_face_angle2)
Zp=Zg
;izlaz iz kamena
Zi=-ds_PodHodZ
Xi=Xg
;provera profila
if (Xe<=Xf)
   MSG("Visina H premala ---- H="<<ds_Face_Length2<<" R="<<ds_radius2<<" F="<<ds_margin2)
   lab_h:
   M00
   GOTOB lab_h
endif

G90 G18 DIAM90
X=Xa Z=Za
;ako se radi čelo kamena
if (ds_Face_Length2>0)
   if ((ds_taper_length2>0) and (ds_taper_angle2<>0))
      X=Xb Z=Zb
      X=2*Xc Z=Zc
   else
      X=2*Xc Z=Zc
   endif
   if (ds_Radius2>0)
      G2 X=2*Xd Z=Zd CR=ds_Radius2
   endif
   if (ds_margin2>0)
      G1 X=2*Xe Z=Ze
   endif
   G1 X=2*Xf Z=Zf
   G3 X=2*Xg Z=ZG CR=0.5*ds_PodhodZ
   G1 X=2*Xi Z=Zi
else ; ako nema čela kamena smo prečnik i eventualno konus
    if ((ds_taper_length2>0) and (ds_taper_angle2<>0))
      X=Xb Z=Zb
      X=2*Xc Z=Zc
   else
      X=2*Xc Z=Zc
   endif
endif

M17
