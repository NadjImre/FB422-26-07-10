; trougao desni bok D2 + zaobljenje na vrhu (ne prelazi na levi bok)
G90 G18 DIAM90
G1 X=0 Z=-ds_tool_width-ds_podhodz
G1 X=0 Z=-Ds_X3-Th_H0*TAN(Th_Alpha) RND=Th_R2
G1 X=2*(Th_H+Ds_X1) Z=-Ds_X3-(Th_H0-Th_H-Ds_X1)*TAN(Th_Alpha) RND=Th_R1
G1 X=2*(Th_H+Ds_X1) Z=-Ds_X3+1+(Th_H0-Th_H-Ds_X1)*TAN(Th_Beta)

M17
